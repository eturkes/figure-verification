# Python
__pycache__/
*.py[cod]
*$py.class
*.egg
*.egg-info/
build/
dist/

# Test / type / lint caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.coverage
htmlcov/

# uv virtualenvs (project-local layers)
.venv/
.venv-host/
# Backend model server venv (CUDA runtime; rebuild: uv sync --locked --project model_backend/runtime)
.venv-model/

# Local model weights (fetched per model_backend/runtime/README.md; large, host-portable).
# Identity IS tracked: model_backend/runtime/snapshot.json pins revision + per-file sha256.
models/

# Open WebUI: app venv + runtime state (sqlite/uploads/cache; regenerable, recipe in webui/)
.venv-webui/
# The suite on CPython 3.11 (tools/py311; rebuilt by the gate's tests311 stage)
.venv-py311/
.webui-data/
# codex app-server home of the --codex bridge (webui/codex_bridge.py; holds no credential file)
.codex-bridge/

# Outputs of retired harnesses + the retired JSON-spec service (`bench/`, `python -m demo`, its
# signing state + DuckDB oracle): nothing writes them now; kept so an older checkout's leftovers
# stay ignored.
bench/reports/
demo/reports/
.verifier-state/
*.duckdb
*.duckdb.wal

# Secrets / local env
.env
.env.*
!.env.example

# One-command launcher runtime (per-service *.log + launch.pid; regenerable)
.launch-logs/
*.log

# Headroom tokensave code-graph state (regenerable: `tokensave init`/`sync`)
.tokensave/

# Agent research scratch (source PDFs/notes; findings distil into spec.md + rules, papers stay upstream)
.agent/research-tmp/
# Teammate scratch root (`.scratch/agents/<name>.md` reports + roster, `.scratch/worktrees/<name>` per-teammate checkouts; MAIN harvests, then distils into spec.md + rules)
.scratch/

# Claude Code machine-local (settings + private instructions)
.claude/settings.local.json
CLAUDE.local.md
# Headroom wrap session state: live-session marker (pid/port/env key; removed on exit), the env keys it owns in settings.local.json + that file's lock
.claude/.headroom_wrap_marker.json
.claude/.headroom_wrap_owners.json
.claude/.headroom_wrap_settings.lock

# Measurement harness outputs: generated corpora + result JSONs land beside the scripts (S1 + W1
# print to stdout) and run to hundreds of MB. Sources + published expectations tracked; rerun = evidence.
.agent/measurements/*-data/
.agent/measurements/results/
.agent/measurements/t7-*.csv
.agent/measurements/t7-*.f64le
.agent/measurements/*.json
!.agent/measurements/package.json
!.agent/measurements/design_intent.json
!.agent/measurements/a1_ja.json
!.agent/measurements/a2_labels.json
!.agent/measurements/a3_clinical.json
!.agent/measurements/m17u3_phrasings.json
.agent/measurements/*.log
.agent/measurements/f7-*.png
.agent/measurements/node_modules/
.agent/measurements/pyodide-index/

# OS
.DS_Store
Thumbs.db
