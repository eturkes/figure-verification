  "source": "import pandas as pd\nimport matplotlib.pyplot as plt\n\n# Read the CSV file\ndf = pd.read_csv('/mnt/uploads/weather.csv')\n\n# Group the data by city and calculate the average temperature\naverage_temperatures = df.groupby('city')['temp_c'].mean()\n\n# Plot the average temperatures\nplt.figure(figsize=(10, 6))\naverage_temperatures.plot(kind='bar')\nplt.title('Average Temperature by City')\nplt.xlabel('City')\nplt.ylabel('Temperature (C)')\nplt.xticks(rotation=45)\nplt.tight_layout()\nplt.show()\n",
