{
  "version": "vplot-0.1",
  "dataset": {
    "name": "sales.csv",
    "hash": "sha256:b97410105bddf8e972101ac704efa1d6f319550708240a15b63cb476b656adf4"
  },
  "transform": [
    {
      "op": "group_by",
      "keys": [
        "month"
      ]
    },
    {
      "op": "aggregate",
      "measures": [
        {
          "field": "revenue",
          "fn": "sum",
          "as": "total_revenue"
        }
      ]
    }
  ],
  "mark": "pie",
  "encoding": {
    "x": {
      "field": "month",
      "type": "ordinal"
    },
    "y": {
      "field": "total_revenue",
      "type": "quantitative"
    }
  }
}
