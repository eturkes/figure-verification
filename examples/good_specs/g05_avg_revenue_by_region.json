{
  "version": "vplot-0.1",
  "dataset": {
    "name": "sales.csv",
    "hash": "sha256:b97410105bddf8e972101ac704efa1d6f319550708240a15b63cb476b656adf4"
  },
  "transform": [
    {
      "op": "group_by",
      "keys": [
        "region"
      ]
    },
    {
      "op": "aggregate",
      "measures": [
        {
          "field": "revenue",
          "fn": "mean",
          "as": "avg_revenue"
        }
      ]
    },
    {
      "op": "sort",
      "by": [
        {
          "field": "region",
          "order": "ascending"
        }
      ]
    }
  ],
  "mark": "bar",
  "encoding": {
    "x": {
      "field": "region",
      "type": "nominal"
    },
    "y": {
      "field": "avg_revenue",
      "type": "quantitative"
    }
  }
}
